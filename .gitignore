# Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets and local configuration
.env
.env.*
!.env.example

# Raw and derived data
#
# Imported artifacts never enter git. Provenance lives in
# docs/audit/TRACK_A_IMPORT_MANIFEST_001.csv, which records the source path,
# source and destination SHA-256, and byte sizes for every import -- so the data
# is reproducible from its manifest without putting tens of megabytes of
# ERCOT-derived load into history, where removing it would need a rewrite.
#
# data/frozen/ was previously NOT covered here while its siblings were, so a
# single `git add -A` would have committed the 54 MB load artifact.
data/raw/*
data/shared/*
data/frozen/*
data/track_a/*
data/track_b/*
!data/**/.gitkeep

# Training outputs
runs/*
!runs/track_a/
!runs/track_b/
runs/track_a/*
runs/track_b/*
!runs/**/.gitkeep
mlruns/*
*.pt
*.pth
*.ckpt

# Generated experiment artifacts
artifacts/track_a/*
artifacts/track_b/*
artifacts/reviews/*
!artifacts/**/.gitkeep

# Editor and OS files
.vscode/
.DS_Store
Thumbs.db
